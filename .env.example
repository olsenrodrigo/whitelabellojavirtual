# ─────────────────────────────────────────────────────────────────────────────
# Whitelabel Loja Virtual — exemplo de configuração (.env)
# Copie para .env e preencha. NUNCA comite o .env (segredos).
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:pass@localhost:5432/loja
JWT_SECRET=troque-por-um-segredo-forte
SETUP_SECRET=                      # protege rota de setup inicial (opcional)

# Admin inicial (seed)
ADMIN_EMAIL=admin@loja.com.br
ADMIN_PASSWORD=troque-esta-senha

# E-mail (SMTP) — confirmação de pedido, etc.
CONTACT_EMAIL=contato@loja.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Pagamento ───────────────────────────────────────────────────────────────
# Gateway ativo no checkout: mercadopago (default) | asaas
PAYMENT_GATEWAY=mercadopago

# MercadoPago — checkout do site (fluxo atual em server/payment.ts)
MERCADO_PAGO_ACCESS_TOKEN=         # TEST-... (sandbox) | APP_USR-... (produção)

# MercadoPago — conector/MCP (server/mercadopago/). Pode reusar o mesmo token.
MP_ACCESS_TOKEN=                   # vazio = MOCK. Sandbox começa com TEST-
MP_PUBLIC_KEY=                     # só p/ tokenizar cartão de teste no sandbox
MP_ENV=sandbox                     # sandbox | production (default: derivado do token)
MP_MOCK=                           # 1 força mock mesmo com token
MP_WEBHOOK_SECRET=                 # "assinatura secreta" do painel MP (valida x-signature)
MP_USER_AGENT=LojaVirtual
MP_MAX_INSTALLMENTS=12

# Asaas — checkout (PAYMENT_GATEWAY=asaas) e conector/MCP (server/asaas/)
ASAAS_API_KEY=                     # vazio = MOCK. Sandbox começa com $aact_hmlg_
ASAAS_ENV=sandbox                  # sandbox | production
ASAAS_MOCK=                        # 1 força mock mesmo com chave
ASAAS_USER_AGENT=LojaVirtual
ASAAS_WEBHOOK_TOKEN=               # segredo do header asaas-access-token (gere forte)
ASAAS_WEBHOOK_URL=                 # URL pública do POST /api/webhooks/asaas

# ─── Frete / etiquetas (SmartEnvios) ─────────────────────────────────────────
SMARTENVIOS_TOKEN=                 # vazio = MOCK
SMARTENVIOS_ENV=production         # sandbox | production
SMARTENVIOS_MOCK=                  # 1 força mock
SMARTENVIOS_AUTO_LABEL=0           # 1 = gera etiqueta ao confirmar pagamento (webhook)
FREE_SHIPPING_ABOVE=199            # frete grátis acima de (R$)
SHIPPING_DISCOUNT_PERCENT=0        # desconto % no frete

# Remetente (origem dos envios)
SENDER_NAME=
SENDER_DOCUMENT=                   # CNPJ/CPF do remetente
SENDER_ZIPCODE=
SENDER_STREET=
SENDER_NUMBER=
SENDER_NEIGHBORHOOD=
SENDER_COMPLEMENT=
SENDER_PHONE=
SENDER_EMAIL=

# Documento fiscal do envio
DOCUMENT_MODE=dc                   # dc (Declaração de Conteúdo) | nfe
LABEL_DOCUMENT_TYPE=label_integrated_danfe
