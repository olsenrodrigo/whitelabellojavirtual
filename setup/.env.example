# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/loja_virtual

# ─── Segurança ────────────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-string-aleatoria-longa-aqui
# Opcional: protege a rota de primeiro acesso com uma chave extra
# SETUP_SECRET=sua-chave-secreta-de-setup

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── E-mail SMTP (obrigatório para MFA e notificações) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app-gmail

# E-mail que recebe formulários de contato
CONTACT_EMAIL=contato@seusite.com.br

# ─── Meios de pagamento (opcional — configure via painel admin) ───────────────
# MERCADO_PAGO_TOKEN=APP_USR-...
# MERCADO_PAGO_PUBLIC_KEY=APP_USR-...

# ── SmartEnvios (frete/etiqueta) ─────────────────────────────────────────────
SMARTENVIOS_TOKEN=
SMARTENVIOS_ENV=production
DOCUMENT_MODE=nfe
LABEL_DOCUMENT_TYPE=label_integrated_danfe
SMARTENVIOS_AUTO_LABEL=0
SENDER_NAME=
SENDER_DOCUMENT=
SENDER_ZIPCODE=
SENDER_STREET=
SENDER_NUMBER=
SENDER_NEIGHBORHOOD=
SENDER_COMPLEMENT=
SENDER_PHONE=
SENDER_EMAIL=
FREE_SHIPPING_ABOVE=199
SHIPPING_DISCOUNT_PERCENT=0

# Admin padrão criado no primeiro boot (troque a senha depois)
ADMIN_EMAIL=admin@puraflora.com.br
ADMIN_PASSWORD=PuraFlora@2026
